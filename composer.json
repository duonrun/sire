{
	"name": "celema/sire",
	"description": "A PHP validation library",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celema.dev"
		}
	],
	"homepage": "https://celema.dev/sire",
	"keywords": [
		"celema",
		"validation"
	],
	"autoload": {
		"psr-4": {
			"Celema\\Sire\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Celema\\Sire\\Tests\\": "tests"
		}
	},
	"require": {
		"php": "^8.5",
		"symfony/html-sanitizer": "^8.0"
	},
	"require-dev": {
		"celema/dev": "^5.0"
	},
	"scripts": {
		"test": "@php vendor/bin/phpunit --testdox --no-coverage --colors=always",
		"types": "@php vendor/bin/psalm --no-cache",
		"lint": [
			"@php vendor/bin/mago fmt --check",
			"@php vendor/bin/mago lint"
		],
		"docs:format": "npx prettier@3.6.2 --write --config docs/.prettierrc README.md CHANGELOG.md LICENSE.md docs/",
		"docs:lint": "npx markdownlint-cli2@0.22.1 --config vendor/celema/dev/config/markdownlint.jsonc README.md CHANGELOG.md LICENSE.md docs/",
		"coverage:test": "@php -d xdebug.mode=coverage vendor/bin/phpunit --testdox --path-coverage --colors=always",
		"coverage:analyze": "@php vendor/bin/coverlyzer .coverage/coverage.php",
		"coverage": [
			"composer coverage:test",
			"composer coverage:analyze"
		],
		"ci": [
			"composer lint",
			"composer coverage",
			"composer types"
		],
		"ci:full": [
			"composer ci",
			"composer docs:lint"
		]
	}
}
